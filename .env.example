# Quartermaster uses Google Gemini through the Strands native provider.
# Get a key at https://aistudio.google.com/apikey
#
# One key is enough. Numbered keys are rotated automatically when a key hits
# its rate limit, which matters during a live demo on a free tier.
GEMINI_API_KEY=your-key-here
# GEMINI_API_KEY_2=optional-second-key
# GEMINI_API_KEY_3=optional-third-key
